# ─────────────────────────────────────────────────────────────
# TOBI — Environment Template
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env   (bash)   |   Copy-Item .env.example .env  (PowerShell)
# `.env` is git-ignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# === LLM / Model routing ============================================
# Which provider Tobi uses: openrouter | claude | opus | sonnet | haiku | auto
#   openrouter -> free models (needs OPENROUTER_API_KEY)
#   claude/opus/sonnet/haiku -> Anthropic (needs ANTHROPIC_API_KEY)
#   auto -> Claude if ANTHROPIC_API_KEY set, else falls back to OpenRouter
PRIMARY_MODEL=openrouter

# OpenRouter (https://openrouter.ai/keys) — used when PRIMARY_MODEL=openrouter
OPENROUTER_API_KEY=

# Anthropic (https://console.anthropic.com) — used for claude/auto modes
# AND required by the Telegram coding agent (write_file/run_bash tools).
ANTHROPIC_API_KEY=

# OpenAI (optional) — only referenced by the dashboard health checks.
OPENAI_API_KEY=

# The Models page (MC → /models) can store any of the keys below in the Vault
# instead; these names exist so a key already in the environment is picked up.
# DeepSeek (https://platform.deepseek.com) — deepseek-v4-pro / -flash / -flash-vision-exp
DEEPSEEK_API_KEY=
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# xAI Grok (https://console.x.ai)
XAI_API_KEY=

# === Telegram (primary chat UI) =====================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated. Only these may use the bot.
TELEGRAM_ALLOWED_USERS=
# Default chat id for proactive/scheduled messages (usually your own user id).
TELEGRAM_CHAT_ID=

# === Research =======================================================
# Tavily web search (https://tavily.com) — powers the research engine.
TAVILY_API_KEY=

# === Ports / URLs ===================================================
API_PORT=8000
DASHBOARD_PORT=8080
# Override the Mission Control URL shown in messages (optional).
# Leave blank for local: it resolves to http://localhost:DASHBOARD_PORT
DASHBOARD_URL=

# === Database =======================================================
# SQLite path. This repo-local path is git-ignored. On the owner's Windows
# workstation, prefer an absolute D-drive path to keep runtime data off C:.
DB_PATH=.tobi/agent.db

# === API server auth ================================================
# Shared key for the REST API (api/server.py). Optional for local use.
API_KEY=

# === Integrations (all optional — feature-gated by presence of keys) =
NOTION_API_KEY=
GITHUB_TOKEN=
GRAPH_GITHUB_REPOS=              # comma-separated owner/name list for graph sync (max 10), e.g. octocat/Hello-World,torvalds/linux
GOOGLE_CLIENT_ID=                 # OAuth2 client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=             # OAuth2 client secret (same page)
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/oauth/callback
VERCEL_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# === OpenAI Codex (GPT-5.6 models) ==================================
# Auth path 1: ChatGPT subscription — run `codex login`, then the token is
#              auto-read from ~/.codex/auth.json (no paste needed).
# Auth path 2: Paste the access_token manually from ~/.codex/auth.json.
# Auth path 3: Set OPENAI_API_KEY for platform API billing (sk-... key).
CODEX_ACCESS_TOKEN=
CODEX_CHATGPT_ACCOUNT_ID=

# === Controlled coding runner ======================================
# local: external coding CLIs run as scrubbed child processes of MC (development).
# service: MC submits durable jobs to `python -m core.coding_runner_service`
#          running under a separate supervised VPS service (production).
TOBI_CODING_RUNNER_MODE=local
TOBI_CODING_RUNNER_STARTUP_TIMEOUT_SECONDS=15
# OpenCode + GLM reads this by reference. Configure it through the MC Vault and
# inject it into MC; service mode transfers only this selected value through an
# encrypted per-job envelope.
ZAI_API_KEY=

# === Hermes sync target =============================================
# Repo-local and git-ignored. Use an absolute D-drive path on the owner's PC.
HERMES_DIR=.hermes

# === Codespaces-only (leave unset for local dev) ====================
# CODESPACE_NAME=
# GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=
