{
  "dataset_version": "v1",
  "schema_version": "tobival.supported-workflows.v1",
  "scope": "Bounded Mission Control work only; open-ended coding, research, design, and writing are reported separately.",
  "workflows": [
    {"workflow_id":"system.status.read","intents":["system status","health summary","architecture summary","usage summary","storage summary"],"required_fields":[],"allowed_tools":[],"policy_class":"read","stop_condition":"bounded local projection returned","success_evidence":["projection_ref","freshness"],"recovery_options":["unavailable"],"summary_shape":"status_facts"},
    {"workflow_id":"project.list","intents":["list projects","show projects"],"required_fields":[],"allowed_tools":["tobi.projects.list_projects@1"],"policy_class":"read","stop_condition":"typed project list returned","success_evidence":["tool_result_ref"],"recovery_options":["empty","unavailable"],"summary_shape":"project_list"},
    {"workflow_id":"project.create","intents":["create project"],"required_fields":["name"],"allowed_tools":[],"policy_class":"reversible_action","stop_condition":"project receipt exists","success_evidence":["receipt_ref"],"recovery_options":["clarify","refuse"],"summary_shape":"action_receipt"},
    {"workflow_id":"task.list","intents":["list tasks","show tasks"],"required_fields":["project_id"],"allowed_tools":[],"policy_class":"read","stop_condition":"typed task list returned","success_evidence":["project_ref","result_ref"],"recovery_options":["clarify","empty"],"summary_shape":"task_list"},
    {"workflow_id":"task.create","intents":["create task","add task"],"required_fields":["project_id","title"],"allowed_tools":["tobi.projects.create_task@1"],"policy_class":"reversible_action","stop_condition":"task receipt exists","success_evidence":["receipt_ref","project_ref"],"recovery_options":["clarify","refuse","retry"],"summary_shape":"action_receipt"},
    {"workflow_id":"task.complete","intents":["complete task","mark task done"],"required_fields":["task_id"],"allowed_tools":[],"policy_class":"reversible_action","stop_condition":"completion receipt exists","success_evidence":["receipt_ref","task_ref"],"recovery_options":["clarify","refuse"],"summary_shape":"action_receipt"},
    {"workflow_id":"brain.recall","intents":["recall owner context","what do you remember"],"required_fields":["query"],"allowed_tools":[],"policy_class":"sensitive_read","stop_condition":"bounded trusted context returned","success_evidence":["context_manifest_ref","freshness","trust"],"recovery_options":["no_relevant_context","sensitive_context_withheld"],"summary_shape":"grounded_context"},
    {"workflow_id":"resource.list","intents":["list resources","show project resources"],"required_fields":["project_id"],"allowed_tools":[],"policy_class":"read","stop_condition":"typed resource list returned","success_evidence":["project_ref","result_ref"],"recovery_options":["clarify","empty"],"summary_shape":"resource_list"},
    {"workflow_id":"file.inventory","intents":["list files","show files"],"required_fields":["path"],"allowed_tools":["tobi.files.list_files@1"],"policy_class":"local_read","stop_condition":"bounded file inventory returned","success_evidence":["tool_result_ref","path_policy_ref"],"recovery_options":["clarify","deny_path","empty"],"summary_shape":"file_list"},
    {"workflow_id":"file.read","intents":["read file"],"required_fields":["path"],"allowed_tools":["tobi.files.read_file@1"],"policy_class":"local_read","stop_condition":"bounded file result returned","success_evidence":["tool_result_ref","path_policy_ref"],"recovery_options":["clarify","deny_path","too_large"],"summary_shape":"file_result"},
    {"workflow_id":"file.search","intents":["search files","find text"],"required_fields":["query","path"],"allowed_tools":[],"policy_class":"local_read","stop_condition":"bounded matches returned","success_evidence":["result_ref","path_policy_ref"],"recovery_options":["clarify","deny_path","empty"],"summary_shape":"search_matches"},
    {"workflow_id":"policy.evaluate","intents":["check policy","is action allowed"],"required_fields":["action","risk"],"allowed_tools":[],"policy_class":"policy","stop_condition":"typed policy decision returned","success_evidence":["policy_decision_ref"],"recovery_options":["refuse","approval_required"],"summary_shape":"policy_decision"},
    {"workflow_id":"approval.evaluate","intents":["approve action","check approval"],"required_fields":["action_ref"],"allowed_tools":[],"policy_class":"approval","stop_condition":"approval state returned","success_evidence":["approval_ref","policy_decision_ref"],"recovery_options":["approval_required","expired"],"summary_shape":"approval_state"},
    {"workflow_id":"budget.evaluate","intents":["check budget","can run continue"],"required_fields":["run_id"],"allowed_tools":[],"policy_class":"budget","stop_condition":"typed budget decision returned","success_evidence":["budget_ref","run_ref"],"recovery_options":["stop_limit","clarify"],"summary_shape":"budget_state"},
    {"workflow_id":"run.recover","intents":["retry run","resume run","skip step","revise run","cancel run"],"required_fields":["run_id","operation"],"allowed_tools":[],"policy_class":"recovery","stop_condition":"checkpoint transition or bounded refusal recorded","success_evidence":["run_ref","checkpoint_ref","receipt_ref"],"recovery_options":["retry","resume","skip","revise","cancel","refuse"],"summary_shape":"recovery_state"},
    {"workflow_id":"connector.status","intents":["connector status","is integration ready"],"required_fields":["connector_id"],"allowed_tools":[],"policy_class":"connector_read","stop_condition":"readiness and freshness returned","success_evidence":["connector_ref","freshness"],"recovery_options":["unconfigured","stale","unavailable"],"summary_shape":"connector_status"},
    {"workflow_id":"coding.qualify","intents":["coding workflow status","worker qualification","checkpoint status"],"required_fields":["workflow_id"],"allowed_tools":[],"policy_class":"coding_read","stop_condition":"bounded qualification state returned","success_evidence":["workflow_ref","evidence_ref"],"recovery_options":["blocked","unqualified","stale"],"summary_shape":"coding_status"},
    {"workflow_id":"surface.compatibility","intents":["surface run status","compatibility status"],"required_fields":["surface"],"allowed_tools":[],"policy_class":"read","stop_condition":"bounded surface projection returned","success_evidence":["surface_ref","run_ref"],"recovery_options":["legacy_only","unavailable"],"summary_shape":"surface_status"},
    {"workflow_id":"terminal.status","intents":["terminal status","terminal capabilities"],"required_fields":[],"allowed_tools":["tobi.terminal.terminal_status@1"],"policy_class":"local_read","stop_condition":"bounded terminal status returned","success_evidence":["tool_result_ref"],"recovery_options":["unavailable"],"summary_shape":"terminal_status"},
    {"workflow_id":"terminal.typed_command","intents":["run approved command"],"required_fields":["command"],"allowed_tools":["tobi.terminal.run_command@1","tobi.terminal.run_command@2"],"policy_class":"terminal_action","stop_condition":"typed result or refusal returned","success_evidence":["policy_decision_ref","tool_result_ref","receipt_ref"],"recovery_options":["approval_required","refuse","timeout"],"summary_shape":"terminal_result"},
    {"workflow_id":"provider.recover","intents":["recover provider failure","recover malformed output"],"required_fields":["failure_class"],"allowed_tools":[],"policy_class":"recovery","stop_condition":"usable result or truthful bounded recovery returned","success_evidence":["failure_class_ref","recovery_ref"],"recovery_options":["repair","fallback","bounded_failure"],"summary_shape":"provider_recovery"}
  ]
