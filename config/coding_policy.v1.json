{
  "version": 1,
  "repository": {
    "default_branch": "main",
    "allowed_repository": "binhvu284/tobi",
    "allowed_remote_suffix": "binhvu284/tobi.git",
    "worktree_root": ".tobi/developer/worktrees",
    "artifact_root": ".tobi/developer/artifacts",
    "index_root": ".tobi/developer/index"
  },
  "capabilities": {
    "observe": true,
    "sandbox": true,
    "external_workers": true,
    "github": true,
    "merge": false,
    "deploy": false
  },
  "protected_paths": [
    "config/coding_policy*.json",
    "core/coding_policy.py",
    "core/development_store.py",
    "core/vault.py",
    "api/developer.py",
    "core/coding_agent.py",
    "core/coding_loop.py",
    "core/coding_tools.py",
    "core/coding_workers.py",
    "core/coding_contracts.py",
    "core/coding_assessment.py",
    "core/coding_runner.py",
    "core/coding_runner_service.py",
    "core/coding_quality.py",
    "core/coding_learning.py",
    "core/deployment_manager.py",
    "core/git_workspace.py",
    "core/github_coding.py",
    "core/hermes_worker.py",
    "core/release_manager.py",
    "core/repo_index.py",
    "docs/feature-idea-queue/QUEUE.md",
    "docs/feature-idea-queue/**",
    "deploy.sh",
    "setup-vps.sh",
    "scripts/install_coding_runner_service.sh",
    "scripts/systemd/tobi-coding-runner.service.template",
    ".github/**",
    ".env*"
  ],
  "forbidden_paths": [
    ".git/**",
    ".tobi/developer/**",
    "**/*.db",
    "**/*.sqlite*",
    "**/.env*",
    "**/vault*"
  ],
  "index_exclusions": [
    ".git/**",
    ".tobi/**",
    ".env*",
    "node_modules/**",
    "venv/**",
    "dashboard/dist/**",
    "graphify-out/cache/**",
    "logs/**",
    "**/__pycache__/**",
    "**/*.db",
    "**/*.sqlite*",
    "**/*.pem",
    "**/*.key"
  ],
  "commands": {
    "allowed_executables": [
      "git",
      "python",
      "python3",
      "pytest",
      "npm",
      "npx",
      "node",
      "ruff",
      "mypy",
      "powershell",
      "pwsh",
      "bash"
    ],
    "forbidden_arguments": [
      "--force",
      "--force-with-lease",
      "reset --hard",
      "clean -f",
      "checkout --",
      "remote set-url",
      "config credential",
      "push --mirror"
    ],
    "mandatory_checks": [
      ["python", "-m", "compileall", "-q", "core", "api"],
      ["python", "tests/test_coding_agent.py"],
      ["npm", "run", "build", "--prefix", "dashboard"]
    ]
  },
  "workers": {
    "order": ["llm", "hermes"],
    "allow_external_cli": false,
    "allowed_adapters": ["native", "deepseek", "codex", "opencode"],
    "qualified_implementer_adapters": ["codex", "deepseek"],
    "llm_tool_steps": 40,
    "max_file_bytes": 250000,
    "max_tool_output_bytes": 100000
  },
  "limits": {
    "one_active_worker": true,
    "heartbeat_seconds": 5,
    "lost_worker_seconds": 30,
    "no_output_warning_seconds": 90,
    "worker_timeout_seconds": 1800,
    "worker_output_bytes": 2097152,
    "command_timeout_seconds": 900,
    "max_review_cycles": 2,
    "retention_days": 7,
    "storage_warning_bytes": 10737418240,
    "reauth_ttl_seconds": 300
  },
  "loop": {
    "enabled": true,
    "poll_seconds": 10,
    "lease_seconds": 120,
    "retry_backoff_seconds": 30,
    "max_goal_iterations": 12
  },
  "deployment": {
    "target_name": "",
    "checkout_path": "",
    "preflight": [],
    "build": [],
    "restart": [],
    "health_url": "",
    "require_health_revision": true,
    "rollback": []
  }
}
