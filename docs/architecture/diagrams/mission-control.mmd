%% Mission Control - React frontend architecture (canonical). Flowchart-only subset (#20).
%% Refreshed 2026-09-01: Runs plus Evaluations, Brain V2, News V2, GraphSigil, the three-width
%% sidebar, the Chat-to-Developer dispatch card, and the Morpheus workspace.
flowchart TD
  App[App.tsx route composition] --> Theme[ThemeProvider]
  Theme --> Motion[MotionProvider]
  Motion --> Toast[ToastProvider]
  Toast --> Tabs[WorkspaceTabsProvider]
  Tabs --> Shell[AppShell shell and navigation]

  Shell --> Header[Global header and tab strip]
  Shell --> Sidebar[Sidebar - wide, narrow, or closed with hover preview]
  Shell --> Palette[Command palette]
  Shell --> Panes[Mounted workspace route panes]

  Panes --> Chat[Chat and Agent]
  Panes --> Runs[Runs and Evaluations]
  Panes --> Developer[Developer]
  Panes --> Projects[Projects and workspaces]
  Panes --> Brain[Brain V2]
  Panes --> Graph[Graph and GraphSigil]
  Panes --> Evolution[Evolution and Ability]
  Panes --> Architecture[Architecture]
  Panes --> Office[Office V3]
  Panes --> Health[Health, Infrastructure, Performance]
  Panes --> More[News V2, Explore, Models, Control Room, Storage, Integrations, MCP, Settings]
  Panes --> Morpheus[Morpheus workspace]

  Chat --> Dispatch[Developer dispatch card]
  Dispatch --> Developer
  Runs --> EvalCenter[Eval control center]

  Runs --> RuntimeStore[Runtime store, reconnecting]
  Chat --> RuntimeStore
  RuntimeStore --> Client[api.ts barrel]

  Health --> InfraCheck[Infrastructure test panel]
  InfraCheck --> Stream[Server-sent check rows]

  Chat --> Client
  Projects --> Client
  Brain --> Client
  Evolution --> Client
  Architecture --> Client
  Health --> Client
  Developer --> Client
  EvalCenter --> Client

  Client --> Domains[Domain API modules]
  Stream --> Domains
  Domains --> Core[apiCore get and request]
  Core --> DashAPI[FastAPI 8090]
  DashAPI --> RuntimeAPI[Runtime runs, evals, rollout, health]

  Panes --> Async[Shared pending-state primitives]

  Graph -.-> Lazy[Lazy-loaded heavy chunks]
  Office -.-> Lazy
  More -.-> Lazy
  Architecture -.-> Lazy
  Developer -.-> Lazy
  Runs -.-> Lazy
  Morpheus -.-> Lazy
